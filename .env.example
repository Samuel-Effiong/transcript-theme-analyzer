# Copy this file to `.env` (same directory) and fill in your real API key.
# `transcript_theme_analyzer/config.py` auto-loads a `.env` file from the
# current working directory, so run the CLI from this directory.

# --- Provider selection ---
# One of: openrouter | openai
LLM_PROVIDER=openrouter

# --- OpenRouter (default) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
LLM_DEFAULT_MODEL=anthropic/claude-sonnet-5

# --- OpenAI direct (uncomment these three and comment out the OpenRouter ---
# --- block above to switch providers -- no code changes needed) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-REPLACE_ME
# LLM_DEFAULT_MODEL=gpt-4.1

# --- Chunking (map-reduce path for long transcripts) ---
# Target size per chunk, in approximate tokens.
CHUNK_SIZE_TOKENS=12000
# Overlap between adjacent chunks, in approximate tokens (must be < CHUNK_SIZE_TOKENS).
CHUNK_OVERLAP_TOKENS=800
# Transcripts estimated at or under this many tokens skip chunking (fast path).
SINGLE_PASS_TOKEN_LIMIT=20000

# --- Concurrency / reliability ---
# Chunks of a single transcript analyzed at once.
MAX_CONCURRENT_CHUNKS=8
# Transcripts analyzed at once. The main speed lever for large batches --
# without it, a 1800-transcript run is strictly one-at-a-time.
MAX_CONCURRENT_TRANSCRIPTS=4
# Global ceiling on simultaneous API calls. This is the real throttle:
# transcript- and chunk-level concurrency multiply (4 x 8 = 32 in flight),
# so this is what actually keeps a big run under the provider's rate limit.
# Lower it if you see "Retryable error ... RateLimitError" warnings.
MAX_CONCURRENT_REQUESTS=12
LLM_MAX_RETRIES=5
# Seconds before a single API call is abandoned and retried. The SDK default
# is 600, long enough for one stuck call to hold a concurrency slot for ten
# minutes.
LLM_REQUEST_TIMEOUT=180
# Connection-level retries performed by the SDK beneath our own retry loop.
LLM_SDK_MAX_RETRIES=2
# Cap per-call output tokens. Some models default to a very large max
# (e.g. 65536) when unset, which can exceed your provider account's
# available credits/quota (OpenRouter 402 errors) even for a small prompt.
LLM_MAX_OUTPUT_TOKENS=10000
